# ---------- Global ----------
# How the bot talks to Claude (via the Claude Code CLI):
#   subscription (default): your own Claude Pro/Max plan. Run `claude setup-token` and paste the token below.
#                           Usage counts against your plan's limits. Personal use only; never share this token.
#   api:                    pay-as-you-go with ANTHROPIC_API_KEY. Only set the key in this mode.
AUTH_MODE=subscription
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# ANTHROPIC_API_KEY=sk-ant-...   # api mode only

# Models: empty = your plan's default. Or an alias (sonnet, opus) or a full model name.
TRIAGE_MODEL=
AGENT_MODEL=
AGENT_MAX_TURNS=60
AGENT_MAX_BUDGET_USD=3        # api mode only: hard cost cap per coding task
TASK_TIMEOUT_MINUTES=30
AUTO_START=false
GIT_AUTHOR_NAME=BackendBot
GIT_AUTHOR_EMAIL=backendbot@users.noreply.github.com
DATA_DIR=./data
COMPANIES_FILE=./companies.yaml

# ---------- Per-company secrets (names are referenced from companies.yaml) ----------
# Client A
ClientA_SLACK_BOT_TOKEN=xoxb-...
ClientA_SLACK_APP_TOKEN=xapp-...
ClientA_SLACK_USER_TOKEN=xoxp-...
ClientA_JIRA_TOKEN=...
ClientA_GITHUB_TOKEN=github_pat_...
ClientA_ALEX_GITHUB_TOKEN=github_pat_...
ClientA_GITLAB_TOKEN=glpat-...

# Client B
CLIENTB_JIRA_TOKEN=...
CLIENTB_GITLAB_TOKEN=glpat-...
