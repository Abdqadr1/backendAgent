{
  "name": "backendbot",
  "version": "0.1.0",
  "private": true,
  "description": "Personal coding agent: Slack/Jira mention -> triage -> branch -> code -> draft PR -> notify",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.304",
    "@anthropic-ai/sdk": "^0.135.0",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.2.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
